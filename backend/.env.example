# =========================
# SERVER CONFIGURATION
# =========================
PORT=5000
NODE_ENV=development

# =========================
# DATABASE CONFIGURATION
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_intelligence_platform
DB_USER=root
DB_PASSWORD=your_mysql_password

# =========================
# NEWSDATA.IO API
# =========================
NEWSDATA_API_KEY=your_newsdata_api_key
NEWSDATA_BASE_URL=https://newsdata.io/api/1/latest

# =========================
# NEWS FETCH SETTINGS
# =========================
NEWSDATA_DEFAULT_QUERY=technology
NEWSDATA_DEFAULT_LANGUAGE=en
NEWSDATA_DEFAULT_COUNTRY=in
NEWSDATA_DEFAULT_CATEGORY=technology

# =========================
# SYNC CONFIGURATION
# =========================
SYNC_INTERVAL_MINUTES=30
NEWSDATA_MAX_PAGES=10
NEWSDATA_MAX_ARTICLES=100

# =========================
# AI / ANALYSIS SETTINGS
# =========================
ENABLE_AI_ANALYSIS=true

# =========================
# SECURITY
# =========================
CORS_ORIGIN=http://localhost:5173

# =========================
# LOGGING
# =========================
LOG_LEVEL=info